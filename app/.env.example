# Copy to .env for local development (values here are examples only)

# TMDB API key — required for movie search, artwork, and showings
# Get one at https://www.themoviedb.org/settings/api
TMDB_TOKEN=your-tmdb-api-key

# Session cookie signing secret — set a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Mailgun (only needed if you use the Mailgun-based password reset)
# MAILGUN_API_KEY=

# Optional overrides
# PORT=8080
# NODE_ENV=development
